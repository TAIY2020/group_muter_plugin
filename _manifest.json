{
  "manifest_version": 2,
  "version": "2.4.1",
  "name": "群聊静音插件 | GroupMuter Plugin",
  "description": "一个允许管理员通过聊天命令、或麦麦主动让指定群聊临时进入“静音状态”（闭嘴）的群组管理插件。",
  "author": {
    "name": "TaiYang",
    "url": "https://github.com/TAIY2020"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/TAIY2020/group_muter_plugin",
    "homepage": "https://github.com/TAIY2020/group_muter_plugin",
    "documentation": "https://github.com/TAIY2020/group_muter_plugin",
    "issues": "https://github.com/TAIY2020/group_muter_plugin/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "frequency.get_adjust",
    "frequency.set_adjust",
    "chat.get_group_streams",
    "llm.generate",
    "message.get_recent"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "local",
      "value": "./icon.webp"
    }
  },
  "id": "TAIY2020.group-muter-plugin"
}
